# URL base de la API en el bundle del frontend.
# Vacío = rutas relativas (recomendado en local con proxy Vite).
# En producción (Render): URL completa del backend.
# VITE_API_URL=https://cira-web-api.onrender.com

# Solo desarrollo: a dónde reenvía Vite las peticiones /api
# VITE_API_PROXY_TARGET=http://127.0.0.1:5001

# Google Maps (Maps JavaScript API)
# VITE_GOOGLE_MAPS_API_KEY=
